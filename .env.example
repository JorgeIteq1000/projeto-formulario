# ============================================
# CONFIGURAÇÕES DO SERVIDOR
# ============================================
PORT=3000
# Segredo forte que assina os links dos alunos (obrigatório em produção; trocar invalida links já enviados).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LINK_SECRET=

# Arquivo onde as respostas dos alunos são salvas (padrão: data/respostas.json)
# RESPOSTAS_FILE=data/respostas.json

# ============================================
# DOMÍNIO PÚBLICO DO FORMULÁRIO
# ============================================
# Local:
PUBLIC_FORM_URL=http://localhost:5180
FRONTEND_PORT=5180

# Produção Hostinger:
# PUBLIC_FORM_URL=https://certificadosies.com.br

# ============================================
# INTEGRAÇÃO GOOGLE SHEETS
# ============================================
# ID da planilha Google Sheets:
GOOGLE_SHEET_ID=

# Caminho para credenciais da Service Account:
GOOGLE_APPLICATION_CREDENTIALS=../123.json

# Testes locais com a planilha real: lê a planilha, mas NÃO grava o status EMITIR nela
# GOOGLE_SHEET_SOMENTE_LEITURA=true

# Aba com dados pessoais dos alunos (CPF, DATA DE NASCIMENTO, RG, NATURALIDADE). Padrão: DADOS_ALUNOS
# GOOGLE_SHEET_TAB_DADOS=DADOS_ALUNOS
# Arquivo local alternativo (testes sem planilha). Padrão: src/data/dadosAlunos.json
# DADOS_ALUNOS_FILE=

# ============================================
# INTEGRAÇÃO BITRIX24 (CRM / SPA)
# ============================================
# Obrigatório. URL do webhook de entrada do Bitrix24 (contém a chave de acesso; não versionar)
BITRIX24_WEBHOOK_URL=
BITRIX24_SPA_ENTITY_TYPE_ID=1046
BITRIX24_SPA_CATEGORY_ID=76
BITRIX24_SPA_STAGE_DEFAULT=DT1046_76:CLIENT
BITRIX24_SPA_STAGE_REVISAO=DT1046_76:PREPARATION
BITRIX24_SPA_FIELD_OBS=UF_CRM_14_1748872142
BITRIX24_SPA_FIELD_CURSOS=UF_CRM_14_1791995335
